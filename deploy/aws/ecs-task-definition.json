{
  "family": "orquestrador",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::CONTA:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::CONTA:role/orquestradorTaskRole",
  "containerDefinitions": [
    {
      "name": "orquestrador",
      "image": "CONTA.dkr.ecr.REGIAO.amazonaws.com/orquestrador:TAG",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {"name": "LLM_PROVIDER", "value": "mock"},
        {"name": "ORQUESTRADOR_MCP", "value": "stdio"},
        {"name": "ORQUESTRADOR_RAIZ", "value": "/app"},
        {"name": "PORT", "value": "8080"}
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/orquestrador",
          "awslogs-region": "REGIAO",
          "awslogs-stream-prefix": "orquestrador"
        }
      }
    }
  ]
}
