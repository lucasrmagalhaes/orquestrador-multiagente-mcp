# mock roda a suíte e a demonstração sem chave.
# openai, anthropic ou google exigem a chave correspondente.
LLM_PROVIDER=mock
LLM_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Opcional, para um endpoint compatível com a API da OpenAI.
LLM_BASE_URL=

# Tracing hospedado. Sem as chaves, o processo emite log JSON.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# stdio sobe os servidores MCP. processo chama as mesmas funções em memória.
ORQUESTRADOR_MCP=stdio
ORQUESTRADOR_DATA=
ORQUESTRADOR_RAIZ=
ORQUESTRADOR_CHECKPOINT=
PORT=8080
